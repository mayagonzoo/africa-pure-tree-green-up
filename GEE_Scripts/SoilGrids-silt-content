/// USER CONFIGURATION
// Asset paths
var tree_asset = 'users/your_username/TREE_100000';
var silt_asset = 'projects/soilgrids-isric/silt_mean';

// Tree locations (FeatureCollection of tree_ID + coordinates)
var trees = ee.FeatureCollection(tree_asset);

// SoilGrids Silt Content
var silt = ee.Image(silt_asset).select([
  'silt_0-5cm_mean',
  'silt_5-15cm_mean',
  'silt_15-30cm_mean',
  'silt_30-60cm_mean',
  'silt_60-100cm_mean',
  'silt_100-200cm_mean'
]);

// Visualization (optional)
Map.setCenter(26, -25, 6);

var pointsVis = trees.style({
  color: 'green',
  pointSize: 1
});

Map.addLayer(pointsVis, {}, 'Tree locations');

// Sample silt content at tree points
var siltSampled = silt.sampleRegions({
  collection: trees,
  scale: 250,        // Native resolution of SoilGrids
  geometries: true   // Retain geometry for lat/lon extraction
});

// Add latitude and longitude fields
var siltWithLatLon = siltSampled.map(function(feature) {
  var coords = feature.geometry().coordinates();
  return feature.set({
    longitude: coords.get(0),
    latitude: coords.get(1)
  });
});


// Export to Google Drive
Export.table.toDrive({
  collection: siltWithLatLon,
  description: 'Silt_content_tree_100000',
  fileFormat: 'CSV'
});
